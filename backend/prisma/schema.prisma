generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  password           String
  role               Role
  decisions          Decision[]
  discussions        Discussion[]
  approvalsToReview  Approval[]        @relation("ApprovalReviewer")
  approvalsRequested Approval[]        @relation("ApprovalRequester")
  teamMemberships    TeamMember[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  uploadedDocuments  Document[]        @relation("DocumentUploader")
  decisionVersions   DecisionVersion[]
}

model Decision {
  id               Int               @id @default(autoincrement())
  title            String
  problemStatement String
  status           DecisionStatus    @default(Draft)
  createdById      Int
  createdBy        User              @relation(fields: [createdById], references: [id])
  teamId           Int?
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  alternatives     Alternative[]
  documents        Document[]
  discussions      Discussion[]
  approvals        Approval[]
  versions         DecisionVersion[]
  auditLogs        AuditLog[]

  @@index([teamId])
  @@index([createdById])
  @@index([status])
}

model Alternative {
  id          Int      @id @default(autoincrement())
  name        String
  pros        String
  cons        String
  cost        String
  feasibility String
  risk        String
  decisionId  Int
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model Document {
  id           Int      @id @default(autoincrement())
  filename     String
  filePath     String
  category     String   @default("General")
  tags         String   @default("")
  uploadedById Int?
  uploadedBy   User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  decisionId   Int
  decision     Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([decisionId])
  @@index([uploadedById])
  @@index([category])
}

enum Role {
  Employee
  Reviewer
  Manager
  Administrator
}

enum DecisionStatus {
  Draft
  UnderReview
  Rejected
  Approved
  Archived
}

enum DiscussionType {
  Comment
  MeetingNote
  Rationale
}

model Discussion {
  id          Int                    @id @default(autoincrement())
  content     String
  type        DiscussionType         @default(Comment)
  decisionId  Int
  decision    Decision               @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      Discussion?            @relation("DiscussionThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Discussion[]           @relation("DiscussionThread")
  attachments DiscussionAttachment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([decisionId])
  @@index([createdById])
}

model DiscussionAttachment {
  id           Int        @id @default(autoincrement())
  filename     String
  filePath     String
  discussionId Int
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

model Approval {
  id            Int            @id @default(autoincrement())
  decisionId    Int
  reviewerId    Int
  requestedById Int
  level         Int            @default(1)
  status        ApprovalStatus @default(Pending)
  comments      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  actedAt       DateTime?
  decision      Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  reviewer      User           @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([decisionId, reviewerId, level])
  @@index([decisionId])
  @@index([reviewerId, status])
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  decisions   Decision[]
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  userId   Int
  teamRole String   @default("Member")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String
  title      String
  message    String
  entityType String?
  entityId   Int?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  decisionId Int?
  teamId     Int?
  metadata   String    @default("")
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([decisionId, createdAt])
  @@index([teamId, createdAt])
  @@index([action, createdAt])
}

model DecisionVersion {
  id               Int            @id @default(autoincrement())
  decisionId       Int
  version          Int
  title            String
  problemStatement String
  status           DecisionStatus
  changedById      Int
  createdAt        DateTime       @default(now())
  decision         Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  changedBy        User           @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@unique([decisionId, version])
  @@index([decisionId, createdAt])
}
